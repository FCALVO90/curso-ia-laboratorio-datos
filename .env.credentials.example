# ============================================================
# CURSO IA - PLANTILLA DE CREDENCIALES
# ============================================================
#
# USO:
#
#   cp .env.credentials.example .env.credentials
#
# Después edita .env.credentials con las credenciales
# correspondientes a tu entorno local.
#
# IMPORTANTE:
#   - Este fichero es solo una plantilla.
#   - No introducir credenciales reales aquí.
#   - .env.credentials debe permanecer fuera de Git.
# ============================================================


# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=curso_ia
PGUSER=TU_USUARIO_POSTGRESQL
PGPASSWORD=CAMBIAR_LOCALMENTE


# MariaDB
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_DATABASE=curso_ia
MARIADB_USER=TU_USUARIO_MARIADB
MARIADB_PASSWORD=CAMBIAR_LOCALMENTE


# Python - retail_postgresql.py
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=curso_ia
PG_USER=TU_USUARIO_POSTGRESQL
PG_PASSWORD=CAMBIAR_LOCALMENTE


# ============================================================
# MongoDB
# ============================================================

# Instalación local sin autenticación
MONGO_URI=mongodb://localhost:27017/curso_ia

# Si MongoDB requiere autenticación, definir la URI únicamente
# en el fichero local .env.credentials.
#
# No introducir credenciales reales en esta plantilla.
